// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BookingRequest {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(255)
  email         String   @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  workingOn     String   @db.Text // "What are you working on?"
  challenge     String?  @db.Text // "What is your biggest challenge?"
  figureOut     String?  @db.Text // "What would you like to figure out?"
  website       String?  @db.VarChar(500) // "Website / LinkedIn / Instagram"
  sessionType   String?  @db.VarChar(100)
  preferredDate DateTime?
  preferredTime String?  @db.VarChar(100)
  
  // Admin management fields
  status        String   @default("NEW") @db.VarChar(20) // NEW, REVIEWING, APPROVED, SCHEDULED, COMPLETED, CANCELLED, REJECTED
  adminNotes    String?  @db.Text
  
  // Scheduling fields
  scheduledDate DateTime?
  scheduledTime String?  @db.VarChar(100)
  meetingType   String?  @db.VarChar(100) // e.g., "Zoom", "Google Meet", "Phone"
  meetingLink   String?  @db.VarChar(500)

  // Payment fields
  paymentStatus   String   @default("PENDING") @db.VarChar(20) // PENDING, SUBMITTED, VERIFIED, FAILED
  paymentProofUrl String?  @db.Text
  paymentAmount   String?  @db.VarChar(50)

  // Post-session report (stored as JSON text)
  sessionReport   String?  @db.Text
  
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Indexes for efficient querying
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255) // Should be hashed
  name      String?  @db.VarChar(255)
  role      String   @default("admin") @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResets PasswordReset[]
  sessions       AdminSession[]
  
  @@index([email])
}

model PasswordReset {
  id          String   @id @default(cuid())
  email       String   @db.VarChar(255)
  adminUserId String?  @db.VarChar(255)
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique @db.VarChar(255)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([tokenHash])
  @@index([adminUserId])
}

model AdminSession {
  id         String   @id @default(cuid())
  adminUser  AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId String  @db.VarChar(255)
  tokenHash  String   @unique @db.VarChar(255)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([adminUserId])
}

model AdminSecurityEvent {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(100)
  ip        String?  @db.VarChar(100)
  userAgent String?  @db.VarChar(512)
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

model AdminSettings {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(255)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([key])
}
